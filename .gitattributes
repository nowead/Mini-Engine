# Normalize all text files to LF in the repository.
# All platforms (macOS, Linux, Windows) check out as LF.
* text=auto eol=lf

# Explicitly mark binary files so Git never touches their line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.hdr  binary
*.exr  binary
*.spv  binary
*.ttf  binary
*.otf  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.lib  binary
*.a    binary
*.so   binary
*.dylib binary
